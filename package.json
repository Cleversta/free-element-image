{
  "name": "freelement-images",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write app components lib tests scripts *.config.*",
    "optimize:svg": "svgo --folder public --recursive --multipass --quiet --config svgo.config.mjs",
    "check:services": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/check-services.mjs",
    "cleanup:publications": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/cleanup-publications.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@supabase/supabase-js": "2.116.0",
    "next": "15.5.25",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "prettier": "^3.0.0",
    "svgo": "^4.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "$sharp"
  }
}
