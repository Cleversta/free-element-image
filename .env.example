# Copy this template to .env.local and fill in your credentials there.
# Never commit .env.local. Keep this example free of real credentials.
# These variables are server-only. Do not prefix them with NEXT_PUBLIC_.

# Supabase project URL and backend secret key starting with sb_secret_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# One set of R2 credentials with Object Read & Write access to BOTH buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Private submissions: keep public access disabled. No public URL is needed.
R2_PRIVATE_BUCKET=freelement-submissions

# Published images: a separate bucket for approved public images.
R2_PUBLIC_BUCKET=freelement-public

# Leave empty for now. Later, use the HTTPS custom domain of the PUBLIC bucket.
R2_PUBLIC_BASE_URL=

# Website address, separate from the image domain. Use localhost for development.
# When deploying, set this to your website's HTTPS address.
SITE_URL=http://localhost:3000

# Cloudflare Turnstile widget: allow your website hostname in its settings.
# SITE_KEY is public widget configuration; SECRET_KEY stays on the server.
# Both are needed before the Publish form accepts submissions.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private owner login key for /admin. Use at least 32 random characters.
# Never share it with visitors or prefix it with NEXT_PUBLIC_.
ADMIN_ACCESS_KEY=

# Mixed publishing: true publishes only server-rendered, verified scenes with unflagged text.
# Requires migration 003_image_reports.sql and owner access; otherwise scenes stay pending.
AUTO_PUBLISH=true
